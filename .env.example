# ─────────────────────────────────────────────────────────────
# 이 파일은 "어떤 값을 넣어야 하는지" 안내용입니다. 실제 키를 여기에 쓰지 마세요.
# 실제 값은 Vercel > Project > Settings > Environment Variables 에 입력합니다.
# (로컬에서 `vercel dev` 로 테스트할 때만 이 파일을 .env.local 로 복사해서 값 입력 — .gitignore 처리됨)
# ※ 모든 값은 서버(Functions/Middleware)에서만 읽히며 브라우저로 전달되지 않습니다.
# ─────────────────────────────────────────────────────────────

# [필수] Supabase > Project Settings > Data API (또는 API) > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# [필수] Supabase > Project Settings > API Keys > anon(legacy) 또는 publishable 키
#        ※ service_role / secret 키는 넣지 마세요 (필요 없음)
SUPABASE_ANON_KEY=

# [선택] Supabase > Project Settings > JWT Keys > Legacy JWT Secret
#        JWT 서명이 레거시(HS256)인 프로젝트만 입력. 신규 비대칭 키(JWT Signing Keys) 사용 시 비워두면 JWKS로 자동 검증
SUPABASE_JWT_SECRET=

# [필수] 구글/카카오 로그인 허용 이메일 (쉼표 구분, '@도메인' 은 도메인 전체 허용)
#        여기에 없는 소셜 계정은 로그인되어도 접근 차단됩니다.
ALLOWED_EMAILS=someone@gmail.com, someone@kakao.com

# [선택] ID/PW 계정용 내부 도메인 (기본값 madeleine.local)
#        사용자가 'user01' 입력 → user01@madeleine.local 로 로그인
#        이 도메인의 계정은 자동 허용됩니다.
LOGIN_ID_DOMAIN=madeleine.local

# [선택] OAuth 콜백 주소 고정이 필요할 때만 (예: https://carang-inventory.vercel.app)
SITE_URL=
